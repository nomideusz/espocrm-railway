{
  "services": {
    "29d64360-a372-405e-9fce-ae46c9862afd": {
      "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/espocrm.svg",
      "name": "EspoCRM",
      "build": {},
      "deploy": {
        "startCommand": null,
        "healthcheckPath": "/",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "repo": "https://github.com/nomideusz/espocrm-railway",
        "rootDirectory": "/espocrm"
      },
      "variables": {
        "PORT": {
          "defaultValue": "80",
          "description": "Port Apache listens on - leave as is",
          "isOptional": false
        },
        "ESPOCRM_ADMIN_PASSWORD": {
          "defaultValue": "${{secret(20, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Password for the admin login, set on first boot only - copy it from here to log in, then change it in EspoCRM",
          "isOptional": false
        },
        "ESPOCRM_SITE_URL": {
          "defaultValue": "https://${{RAILWAY_PUBLIC_DOMAIN}}",
          "description": "Address used in links, emails and the live-update connection - set it to your custom domain when you add one",
          "isOptional": false
        },
        "ESPOCRM_DATABASE_PLATFORM": {
          "defaultValue": "Postgresql",
          "description": "Database type - leave as is",
          "isOptional": false
        },
        "ESPOCRM_DATABASE_HOST": {
          "defaultValue": "${{Postgres.RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Postgres host - private network, leave as is",
          "isOptional": false
        },
        "ESPOCRM_DATABASE_PORT": {
          "defaultValue": "5432",
          "description": "Postgres port",
          "isOptional": false
        },
        "ESPOCRM_DATABASE_NAME": {
          "defaultValue": "${{Postgres.POSTGRES_DB}}",
          "description": "Postgres database - leave as is",
          "isOptional": false
        },
        "ESPOCRM_DATABASE_USER": {
          "defaultValue": "${{Postgres.POSTGRES_USER}}",
          "description": "Postgres user - leave as is",
          "isOptional": false
        },
        "ESPOCRM_DATABASE_PASSWORD": {
          "defaultValue": "${{Postgres.POSTGRES_PASSWORD}}",
          "description": "Postgres password - leave as is",
          "isOptional": false
        }
      },
      "networking": {
        "serviceDomains": {
          "<hasDomain>": {}
        }
      },
      "volumeMounts": {
        "29d64360-a372-405e-9fce-ae46c9862afd": {
          "mountPath": "/var/www/html/data"
        }
      }
    },
    "2865a2fa-e183-4c89-86ec-a92aec2bf8e2": {
      "icon": "https://devicons.railway.app/i/postgresql.svg",
      "name": "Postgres",
      "build": {},
      "deploy": {
        "startCommand": null,
        "healthcheckPath": null,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "image": "ghcr.io/railwayapp-templates/postgres-ssl:17"
      },
      "variables": {
        "POSTGRES_DB": {
          "defaultValue": "espocrm",
          "description": "Database name",
          "isOptional": false
        },
        "POSTGRES_USER": {
          "defaultValue": "espocrm",
          "description": "Database user",
          "isOptional": false
        },
        "POSTGRES_PASSWORD": {
          "defaultValue": "${{secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Auto-generated database password",
          "isOptional": false
        },
        "PGDATA": {
          "defaultValue": "/var/lib/postgresql/data/pgdata",
          "description": "Data subdirectory - keeps Postgres happy on Railway volumes",
          "isOptional": false
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "defaultValue": "60",
          "description": "Time for Postgres to shut down cleanly on redeploy",
          "isOptional": false
        }
      },
      "networking": {
        "serviceDomains": {}
      },
      "volumeMounts": {
        "2865a2fa-e183-4c89-86ec-a92aec2bf8e2": {
          "mountPath": "/var/lib/postgresql/data"
        }
      }
    }
  }
}
